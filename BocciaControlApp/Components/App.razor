<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BocciaControlApp.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeWithoutPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModeWithoutPrerender" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sin prerenderizado: cada página se inicializa una sola vez y abre una única conexión SignalR.
    private static readonly IComponentRenderMode RenderModeWithoutPrerender = new InteractiveServerRenderMode(prerender: false);
}
